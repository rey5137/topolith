<?xml version="1.0" encoding="UTF-8"?>
<!-- Host parent. Deliberately has no parent: a host builds like an outside adopter, taking every version from the
     platform BOM (D-68). Its revision must equal the reactor's; HostBuildAc09Test fails when they drift. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.rey5137</groupId>
    <artifactId>topolith-sample-hosts</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>Topolith Sample Hosts</name>
    <description>Reference adopter monolith, hybrid and none topologies</description>
    <modules>
        <module>monolith</module>
        <module>hybrid</module>
        <module>payment-host</module>
    </modules>
    <properties>
        <revision>0.1.0-SNAPSHOT</revision>
        <topolith.version>${project.version}</topolith.version>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <!-- snippet:start bom-import -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.rey5137</groupId>
                <artifactId>topolith-bom</artifactId>
                <version>${topolith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <!-- snippet:end bom-import -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>4.2.0</version>
            </plugin>
            <!-- snippet:start host-enforcer -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.7.0</version>
                <executions>
                    <execution>
                        <id>host-enforce</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <dependencyConvergence/>
                                <requireUpperBoundDeps/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- snippet:end host-enforcer -->
        </plugins>
    </build>
</project>
