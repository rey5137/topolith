org.springframework.boot.autoconfigure.AutoConfigurationImportFilter=\
io.github.rey5137.topolith.spring.boot.TopolithAutoConfigurationFilter
org.springframework.boot.autoconfigure.AutoConfigurationImportListener=\
io.github.rey5137.topolith.spring.boot.TopolithExclusionCheck
# Boot runs every Liquibase before every Flyway initializer; Topolith's module runners come last
org.springframework.boot.sql.init.dependency.DatabaseInitializerDetector=\
io.github.rey5137.topolith.spring.boot.ModuleRunnerDetector
